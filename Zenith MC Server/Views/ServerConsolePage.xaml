<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Zenith_MC_Server.Views.ServerConsolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Zenith_MC_Server.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Process Control Toolbar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Consola en Vivo" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="StatusTextBlock" Text="Estado: Detenido" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="StartBtn" Content="Iniciar" Style="{StaticResource AccentButtonStyle}" Click="StartBtn_Click"/>
                <Button x:Name="StopBtn" Content="Detener" Click="StopBtn_Click"/>
                <Button x:Name="RestartBtn" Content="Reiniciar" Click="RestartBtn_Click"/>
                <Button x:Name="KillBtn" Content="Forzar Cierre (Kill)" Background="DarkRed" Foreground="White" Click="KillBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Live Terminal Stream Container -->
        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" BorderThickness="1" BorderBrush="#333333" Padding="12">
            <ScrollViewer x:Name="ConsoleScrollViewer" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="ConsoleOutputTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13" Background="Transparent"
                         Foreground="#00FF66" BorderThickness="0"/>
            </ScrollViewer>
        </Border>

        <!-- Autocomplete Flyout List -->
        <ListView x:Name="AutocompleteListView" Grid.Row="2" MaxHeight="120" Visibility="Collapsed"
                  SelectionChanged="AutocompleteListView_SelectionChanged" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Consolas" Padding="8,4"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Command Input Field -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="CommandInputBox" Grid.Column="0" PlaceholderText="Escribe un comando de Minecraft (ej. op username, whitelist add, stop)..."
                     FontFamily="Consolas" TextChanged="CommandInputBox_TextChanged" KeyDown="CommandInputBox_KeyDown"/>
            <Button Grid.Column="1" Content="Enviar" Style="{StaticResource AccentButtonStyle}" Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Page>
