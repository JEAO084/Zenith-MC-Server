<Page
    x:Class="Zenith_MC_Server.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Server Quick Status Banner -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#15888888" CornerRadius="12" Padding="18" Margin="0,0,8,0" BorderBrush="#25888888" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Control de Ejecución del Servidor" FontWeight="SemiBold" FontSize="14"/>
                    <Button x:Name="BtnToggleServer" Content="▶ Iniciar Servidor" Click="BtnToggleServer_Click" FontWeight="Bold" CornerRadius="8" Padding="20,10" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#15888888" CornerRadius="12" Padding="18" Margin="8,0,0,0" BorderBrush="#25888888" BorderThickness="1">
                <StackPanel Spacing="4">
                    <TextBlock Text="Información del Servidor Activo" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="TxtActiveServerName" Text="Servidor: Servidor Principal" FontSize="13" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtActiveSoftware" Text="Motor: Paper 1.20.4" FontSize="12"/>
                    <TextBlock x:Name="TxtActivePort" Text="Puerto TCP: 25565" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Terminal Console Area -->
        <Border x:Name="ConsoleContainerBorder" Grid.Row="1" Background="#20000000" CornerRadius="12" Padding="14" BorderBrush="#25888888" BorderThickness="1">
            <ScrollViewer x:Name="ConsoleScrollViewer" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtConsoleLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas, Courier New" FontSize="13" Background="Transparent" Foreground="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0"/>
            </ScrollViewer>
        </Border>

        <!-- Command Input & Suggestion Bar -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="CmdAutoSuggestBox" Grid.Column="0" PlaceholderText="Ingresa un comando de servidor otorgado por el servidor..." TextChanged="CmdAutoSuggestBox_TextChanged" SuggestionChosen="CmdAutoSuggestBox_SuggestionChosen" QuerySubmitted="CmdAutoSuggestBox_QuerySubmitted" CornerRadius="8" Margin="0,0,8,0"/>
            <Button x:Name="BtnSendCommand" Grid.Column="1" Content="Enviar Comando" Click="BtnSendCommand_Click" FontWeight="Bold" CornerRadius="8" Padding="18,8"/>
        </Grid>
    </Grid>
</Page>
