<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Zenith_MC_Server.Views.FileExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Zenith_MC_Server.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Explorador de Archivos y Editor Integrado" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Navega la estructura del servidor e inspecciona archivos de configuración (.yml, .properties, .json, .toml)." Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
        </StackPanel>

        <!-- Main Workspace split into Sidebar Tree & Editor -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- File Tree Panel, Mejorar este apartado para permitir explorar todos los archivos dentro de la carpeta del servidor, algo similar al explorador de archivos de windows desde su barra lateral isquierda -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <TreeView x:Name="FileTreeView" ItemInvoked="FileTreeView_ItemInvoked">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <TreeViewItem ItemsSource="{Binding Children}" Content="{Binding Name}"/>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <!-- Text Editor Workspace -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentFilePathTextBlock" Text="Ningún archivo seleccionado" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Button x:Name="SaveFileButton" Grid.Column="1" Content="Guardar Archivo" Style="{StaticResource AccentButtonStyle}" Click="SaveFileButton_Click" IsEnabled="False"/>
                </Grid>

                <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" BorderThickness="1" BorderBrush="#333333" Padding="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Line Numbers Column -->
                        <TextBlock x:Name="LineNumbersTextBlock" Grid.Column="0" FontFamily="Consolas, Cascadia Code"
                                   FontSize="14" Foreground="#666666" HorizontalAlignment="Right" LineHeight="20"/>

                        <!-- Editor Text Box -->
                        <TextBox x:Name="FileEditorTextBox" Grid.Column="1" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas, Cascadia Code, Courier New" FontSize="14" Foreground="#E0E0E0"
                                 Background="Transparent" BorderThickness="0" TextChanged="FileEditorTextBox_TextChanged"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
