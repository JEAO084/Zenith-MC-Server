<Page
    x:Class="Zenith_MC_Server.Views.ModPluginDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation & Back Button -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <Button Content="← Volver" Click="BtnBack_Click" CornerRadius="6" Padding="12,6"/>
            <Border x:Name="BadgeCategoryType" Background="#20000000" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                <TextBlock x:Name="TxtCategoryBadge" Text="PLUGIN" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>

        <!-- Header Card with Icon, Info and ToggleSplitButton for Sources -->
        <Border Grid.Row="1" Background="#15888888" CornerRadius="12" Padding="18" Margin="0,0,0,16" BorderBrush="#25888888" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="ImgItemIcon" Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtItemTitle" Text="Título del Proyecto" FontSize="20" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="TxtItemAuthor" Text="Autor: -" FontSize="12"/>
                        <TextBlock x:Name="TxtItemDownloads" Text="Descargas: -" FontSize="12"/>
                        <Border x:Name="TagActiveSource" Background="#20000000" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="TxtActiveSourceTag" Text="Fuente: Modrinth" FontSize="10"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Source Selector & Install SplitButton -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <SplitButton x:Name="SplitButtonSource" Content="🚀 Instalar en Servidor" Click="SplitButtonSource_Click" FontWeight="Bold" CornerRadius="8" Padding="16,8">
                        <SplitButton.Flyout>
                            <MenuFlyout x:Name="FlyoutAvailableSources">
                                <!-- Dynamically populated menu items for available sources -->
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SelectorBar Navigation (Replaces TabView) -->
        <SelectorBar Grid.Row="2" x:Name="DetailsSelectorBar" SelectionChanged="DetailsSelectorBar_SelectionChanged" Margin="0,0,0,16">
            <SelectorBarItem x:Name="TabDescription" Text="Descripción" IsSelected="True"/>
            <SelectorBarItem x:Name="TabGallery" Text="Imágenes / Galería"/>
            <SelectorBarItem x:Name="TabVersions" Text="Versiones Disponibles"/>
        </SelectorBar>

        <!-- Dynamic Content Panels based on SelectorBar -->
        <Grid Grid.Row="3">
            <!-- Panel 1: Description -->
            <ScrollViewer x:Name="PanelDescription" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <Border Background="#10888888" CornerRadius="8" Padding="16" BorderBrush="#20888888" BorderThickness="1">
                    <TextBlock x:Name="TxtDescription" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                </Border>
            </ScrollViewer>

            <!-- Panel 2: Images / Gallery Preview -->
            <Grid x:Name="PanelGallery" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#10888888" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#20888888" BorderThickness="1">
                    <Image x:Name="ImgMainPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <GridView Grid.Row="1" x:Name="GrdGalleryThumbnails" MaxHeight="100" IsItemClickEnabled="True" ItemClick="GrdGalleryThumbnails_ItemClick">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="110" Height="70" CornerRadius="6" Margin="4" BorderBrush="#30888888" BorderThickness="1">
                                <Image Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage UriSource="{Binding}" />
                                    </Image.Source>
                                </Image>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- Panel 3: Versions List -->
            <ScrollViewer x:Name="PanelVersions" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <ListView x:Name="LstVersions" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#10888888" CornerRadius="8" Padding="12" Margin="0,4" BorderBrush="#20888888" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding VersionName}" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding ReleaseInfo}" FontSize="11" Foreground="#888888"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Descargar e Instalar" Tag="{Binding}" Click="BtnInstallVersion_Click" CornerRadius="6" Padding="10,4" FontSize="11"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
