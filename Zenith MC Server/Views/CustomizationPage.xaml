<Page
    x:Class="Zenith_MC_Server.Views.CustomizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="Personalización Completa de Interfaz (Estilo Microsoft Store)" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Temas estándar WinUI, modo transparente con opacidad del 25% + Acrylic, y personalización independiente de Consola y Editor." FontSize="12" Foreground="#BBBBBB"/>

            <!-- Card 1: Main Theme & Acrylic Backdrop -->
            <Border Background="#401E1428" CornerRadius="12" Padding="18" BorderBrush="#3A2352" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Modo de Tema Principal y Fondo" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Tema de Aplicación" FontSize="12"/>
                            <ComboBox x:Name="CmbAppTheme" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbAppTheme_SelectionChanged">
                                <ComboBoxItem Content="🌙 Oscuro (Dark Studio)"/>
                                <ComboBoxItem Content="☀️ Claro (Light Clean)"/>
                                <ComboBoxItem Content="✨ Transparente (Acrylic Glass)"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Color de Acento" FontSize="12"/>
                            <ComboBox x:Name="CmbAccentColor" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="💜 Púrpura Zenith (#7C3AED)"/>
                                <ComboBoxItem Content="💙 Azul Neón (#0284C7)"/>
                                <ComboBoxItem Content="💚 Verde Esmeralda (#10B981)"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Efecto Transparente (Backdrop)" FontSize="12"/>
                            <ComboBox x:Name="CmbBackdropType" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="DesktopAcrylic (Acrylic Thin)"/>
                                <ComboBoxItem Content="Mica"/>
                                <ComboBoxItem Content="Sólido"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: Terminal Console -->
            <Border Background="#401E1428" CornerRadius="12" Padding="18" BorderBrush="#3A2352" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Personalización Independiente de Consola Terminal" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Fondo de Consola" FontSize="12"/>
                            <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="🌑 Púrpura Oscuro (#140C1D)"/>
                                <ComboBoxItem Content="⬛ Negro Puro (#000000)"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Texto de Consola" FontSize="12"/>
                            <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="🩵 Azul Cían (#38BDF8)"/>
                                <ComboBoxItem Content="💚 Verde Matrix (#22C55E)"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Fuente de Consola" FontSize="12"/>
                            <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Consolas"/>
                                <ComboBoxItem Content="Cascadia Code"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
