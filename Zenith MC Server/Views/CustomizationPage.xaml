<Page
    x:Class="Zenith_MC_Server.Views.CustomizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="Personalización Completa de Interfaz (Estilo Native Acrylic)" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Selecciona el tema WinUI nativo (Claro u Oscuro). El efecto Acrílico Transparente se aplica automáticamente con acento invertido." FontSize="12"/>

            <!-- Card 1: Main Theme & Native Acrylic Backdrop -->
            <Border Background="#20888888" CornerRadius="12" Padding="18" BorderBrush="#30888888" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Tema Nativo de WinUI" FontSize="16" FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Tema Principal" FontSize="12"/>
                            <ComboBox x:Name="CmbAppTheme" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbAppTheme_SelectionChanged">
                                <ComboBoxItem Content="🌙 Oscuro (Acrylic Dark + Acento Blanco)"/>
                                <ComboBoxItem Content="☀️ Claro (Acrylic Light + Acento Negro)"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Efecto de Fondo" FontSize="12"/>
                            <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch" IsEnabled="False">
                                <ComboBoxItem Content="DesktopAcrylic (Nativo)"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
