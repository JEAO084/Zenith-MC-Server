<Page
    x:Class="Zenith_MC_Server.Views.JavaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="Gestión Avanzada de Entornos Java (JDK)" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Instala y administra versiones de Java 8, 17, 21, 22 y 25 aisladas del sistema operativo." FontSize="12"/>

            <Border Background="#20888888" CornerRadius="12" Padding="18" BorderBrush="#30888888" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Versiones Disponibles para Servidores Minecraft" FontSize="16" FontWeight="SemiBold"/>
                    <ListView x:Name="LstJavaVersions">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11"/>
                                    </StackPanel>
                                    <Button Content="Instalar JDK" Tag="{Binding}" Click="BtnInstallJavaItem_Click" Grid.Column="1" VerticalAlignment="Center" CornerRadius="6"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ProgressBar x:Name="JavaDownloadProgress" Value="0" Maximum="100" Height="8" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtJavaProgressStatus" Text="" FontSize="11"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
