<Page
    x:Class="Zenith_MC_Server.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="Ajustes Globales del Launcher" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>

            <Border Background="#401E1428" CornerRadius="12" Padding="18" BorderBrush="#3A2352" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Editor de Texto Externo" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtExternalEditorExecutablePath" PlaceholderText="Ej: C:\Program Files\Notepad++\notepad++.exe" CornerRadius="8"/>
                        <Button Grid.Column="1" Content="Guardar Editor" Click="BtnSaveExternalEditor_Click" CornerRadius="8"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#401E1428" CornerRadius="12" Padding="18" BorderBrush="#3A2352" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Comportamiento y Automatización" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>
                    <ToggleSwitch Header="Aceptar EULA automáticamente" IsOn="True"/>
                    <ToggleSwitch Header="Reinicio automático del servidor" IsOn="False"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
