<Page
    x:Class="Zenith_MC_Server.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Ajustes Globales del Launcher" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Personaliza el tema visual, entornos Java JDK internos, asignación de RAM y opciones avanzadas." FontSize="12"/>
        </StackPanel>

        <!-- SelectorBar Navigation -->
        <SelectorBar Grid.Row="1" x:Name="SettingsSelectorBar" SelectionChanged="SettingsSelectorBar_SelectionChanged" Margin="0,0,0,16">
            <SelectorBarItem x:Name="TabSettingsGeneral" Text="General y Apariencia" IsSelected="True"/>
            <SelectorBarItem x:Name="TabSettingsJava" Text="Entornos Java (JDK)"/>
            <SelectorBarItem x:Name="TabSettingsAdvanced" Text="Editor y Datos"/>
        </SelectorBar>

        <!-- Dynamic Panels -->
        <Grid Grid.Row="2">
            <!-- Panel 1: General & Apariencia -->
            <ScrollViewer x:Name="PanelSettingsGeneral" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- Theme Selector Card -->
                    <Border Background="#15888888" CornerRadius="12" Padding="18" BorderBrush="#25888888" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Tema Visual de la Aplicación" FontSize="16" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ToggleButton x:Name="TglAppTheme" Content="🌙 Modo Oscuro" Click="TglAppTheme_Click" IsChecked="True" CornerRadius="8" Padding="16,8" FontWeight="SemiBold"/>
                                <TextBlock Text="Utiliza el efecto DesktopAcrylic nativo de WinUI 3." VerticalAlignment="Center" FontSize="12" Foreground="#888888"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Default Server Settings Card -->
                    <Border Background="#15888888" CornerRadius="12" Padding="18" BorderBrush="#25888888" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Opciones Predeterminadas de Servidores" FontSize="16" FontWeight="SemiBold"/>
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="RAM Predeterminada para Nuevos Servidores" FontSize="12"/>
                                    <ComboBox x:Name="CmbDefaultRam" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="CmbDefaultRam_SelectionChanged">
                                        <ComboBoxItem Content="2 GB"/>
                                        <ComboBoxItem Content="4 GB"/>
                                        <ComboBoxItem Content="8 GB"/>
                                        <ComboBoxItem Content="16 GB"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <ToggleSwitch x:Name="ToggleAutoStart" Header="Iniciar servidor automáticamente al abrir" OffContent="Desactivado" OnContent="Activado" Toggled="ToggleAutoStart_Toggled"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Panel 2: Entornos Java JDK Internos -->
            <ScrollViewer x:Name="PanelSettingsJava" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Border Background="#15888888" CornerRadius="12" Padding="18" BorderBrush="#25888888" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Gestión de Entornos Java JDK Internos del Launcher" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Java se gestiona de forma aislada e interna para el launcher sin requerir instalación global en el sistema operativo." FontSize="12" Foreground="#888888"/>

                            <ListView x:Name="LstJavaVersions" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#10888888" CornerRadius="8" Padding="12" Margin="0,4" BorderBrush="#20888888" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                                        <Border Background="#20000000" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{Binding InstalledStatusText}" FontSize="10"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Button Content="Descargar e Instalar" Tag="{Binding}" Click="BtnInstallJava_Click" CornerRadius="6" Padding="12,6" FontSize="11"/>
                                                    <Button Content="Asignar al Servidor Activo" Tag="{Binding}" Click="BtnAssignJavaToActiveServer_Click" CornerRadius="6" Padding="12,6" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Panel 3: Editor Externo y Reset -->
            <ScrollViewer x:Name="PanelSettingsAdvanced" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- External Editor Card -->
                    <Border Background="#15888888" CornerRadius="12" Padding="18" BorderBrush="#25888888" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Editor de Texto Externo" FontSize="16" FontWeight="SemiBold"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtExternalEditorExecutablePath" PlaceholderText="Ej: C:\Program Files\Notepad++\notepad++.exe" CornerRadius="8"/>
                                <Button Grid.Column="1" Content="Guardar Editor" Click="BtnSaveExternalEditor_Click" CornerRadius="8" Padding="14,8"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Factory Reset Card -->
                    <Border Background="#15888888" CornerRadius="12" Padding="18" BorderBrush="#40888888" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="⚠️ Restablecimiento de Fábrica / Reseteo Completo" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Elimina la configuración del launcher e historial. Puedes elegir si deseas eliminar también los archivos y carpetas físicas de todos los servidores." FontSize="12" Foreground="#888888" TextWrapping="Wrap"/>

                            <CheckBox x:Name="ChkDeleteServerFilesOnReset" Content="Eliminar también los archivos y carpetas físicas de todos los servidores" IsChecked="True"/>

                            <Button Content="Restablecer Launcher" Click="BtnFullFactoryReset_Click" FontWeight="Bold" CornerRadius="8" Padding="16,8" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
