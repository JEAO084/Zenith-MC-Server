<Page
    x:Class="Zenith_MC_Server.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="Ajustes Globales y Personalización del Launcher" FontSize="22" FontWeight="Bold"/>

            <!-- Card 1: Theme Selector (Oscuro / Claro) -->
            <Border Background="#20888888" CornerRadius="12" Padding="18" BorderBrush="#30888888" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Tema Visual de la Aplicación (WinUI Acrylic)" FontSize="16" FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Tema Principal" FontSize="12"/>
                            <ComboBox x:Name="CmbAppTheme" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbAppTheme_SelectionChanged">
                                <ComboBoxItem Content="🌙 Oscuro (Acrylic Dark + Acento Blanco)"/>
                                <ComboBoxItem Content="☀️ Claro (Acrylic Light + Acento Negro)"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Fondo de Ventana" FontSize="12"/>
                            <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch" IsEnabled="False">
                                <ComboBoxItem Content="DesktopAcrylic (Nativo)"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: External Editor -->
            <Border Background="#20888888" CornerRadius="12" Padding="18" BorderBrush="#30888888" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Editor de Texto Externo" FontSize="16" FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtExternalEditorExecutablePath" PlaceholderText="Ej: C:\Program Files\Notepad++\notepad++.exe" CornerRadius="8"/>
                        <Button Grid.Column="1" Content="Guardar Editor" Click="BtnSaveExternalEditor_Click" CornerRadius="8"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 3: Factory Reset / Reseteo Completo -->
            <Border Background="#20888888" CornerRadius="12" Padding="18" BorderBrush="#EF4444" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="⚠️ Restablecimiento de Fábrica / Reseteo Completo" FontSize="16" FontWeight="SemiBold" Foreground="#EF4444"/>
                    <TextBlock Text="Elimina permanentemente todos los servidores configurados, carpetas, ajustes e historial del launcher y reinicia a la configuración inicial." FontSize="12" Foreground="#888888" TextWrapping="Wrap"/>
                    <Button Content="⚠️ Eliminar Todo y Resetear Launcher" Click="BtnFullFactoryReset_Click" Background="#EF4444" Foreground="White" FontWeight="Bold" CornerRadius="8" Padding="16,8" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
