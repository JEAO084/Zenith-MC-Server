<Page
    x:Class="Zenith_MC_Server.Views.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="Catálogo de Plugins" FontSize="22" FontWeight="Bold"/>
                <Border x:Name="ActiveServerBadge" Background="#15888888" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right">
                    <TextBlock x:Name="TxtActiveServerFilterBadge" Text="Servidor: -" FontSize="11"/>
                </Border>
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" x:Name="CmbSource" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbSource_SelectionChanged">
                    <ComboBoxItem Content="Todas las Fuentes"/>
                    <ComboBoxItem Content="Modrinth"/>
                    <ComboBoxItem Content="Spiget"/>
                    <ComboBoxItem Content="Bukkit"/>
                </ComboBox>

                <ComboBox Grid.Column="1" x:Name="CmbVersion" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbVersion_SelectionChanged">
                    <ComboBoxItem Content="Versión Activa"/>
                    <ComboBoxItem Content="1.20.4"/>
                    <ComboBoxItem Content="1.20.2"/>
                    <ComboBoxItem Content="1.19.4"/>
                </ComboBox>

                <ComboBox Grid.Column="2" x:Name="CmbCategory" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbCategory_SelectionChanged">
                    <ComboBoxItem Content="Todas las Categorías"/>
                    <ComboBoxItem Content="Administración"/>
                    <ComboBoxItem Content="Utilidades"/>
                    <ComboBoxItem Content="Rendimiento"/>
                </ComboBox>

                <TextBox Grid.Column="3" x:Name="TxtSearch" PlaceholderText="Buscar plugin por nombre o descripción..." TextChanged="TxtSearch_TextChanged" CornerRadius="8"/>
            </Grid>
        </StackPanel>

        <GridView Grid.Row="1" x:Name="GrdPluginItems" IsItemClickEnabled="True" ItemClick="GrdPluginItems_ItemClick" CornerRadius="6">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Border Width="270" Height="160" Background="#15888888" CornerRadius="6" Padding="14" BorderBrush="#25888888" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Image.Source>
                                        <BitmapImage UriSource="{Binding IconUrl}" />
                                    </Image.Source>
                                </Image>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="#20000000" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SourceName}" FontSize="10"/>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" MaxLines="2" Margin="0,6,0,0"/>

                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="{Binding FormattedDownloads}" FontSize="10" VerticalAlignment="Center"/>
                                <Button Content="Ver Detalles" Tag="{Binding}" Click="BtnOpenDetails_Click" FontWeight="SemiBold" CornerRadius="6" HorizontalAlignment="Right" Padding="12,4" FontSize="11"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,12,0,0">
            <Button x:Name="BtnPrevPage" Content="◀ Anterior" Click="BtnPrevPage_Click" CornerRadius="8"/>
            <TextBlock x:Name="TxtPageNumber" Text="Página 1" VerticalAlignment="Center" FontWeight="Bold"/>
            <Button x:Name="BtnNextPage" Content="Siguiente ▶" Click="BtnNextPage_Click" CornerRadius="8"/>
        </StackPanel>
    </Grid>
</Page>
