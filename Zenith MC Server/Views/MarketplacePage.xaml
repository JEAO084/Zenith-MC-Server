<Page
    x:Class="Zenith_MC_Server.Views.MarketplacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <!-- Main Catalog View -->
        <Grid x:Name="ViewCatalogList" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
                <Grid>
                    <TextBlock x:Name="TxtMarketplaceTitle" Text="Catálogo de Plugins &amp; Mods" FontSize="22" FontWeight="Bold"/>
                    <Border x:Name="ActiveServerBadge" Background="#20888888" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtActiveServerFilterBadge" Text="Servidor: Paper 1.20.4" FontSize="11"/>
                    </Border>
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="CmbCategoryType" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbCategoryType_SelectionChanged">
                        <ComboBoxItem Content="Plugins"/>
                        <ComboBoxItem Content="Mods"/>
                    </ComboBox>

                    <ComboBox Grid.Column="1" x:Name="CmbSource" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbSource_SelectionChanged">
                        <ComboBoxItem Content="Todas las Fuentes"/>
                        <ComboBoxItem Content="Modrinth"/>
                        <ComboBoxItem Content="Spigot"/>
                        <ComboBoxItem Content="Bukkit"/>
                    </ComboBox>

                    <ComboBox Grid.Column="2" x:Name="CmbVersion" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbVersion_SelectionChanged">
                        <ComboBoxItem Content="Versión Activa"/>
                        <ComboBoxItem Content="1.20.4"/>
                        <ComboBoxItem Content="1.20.2"/>
                        <ComboBoxItem Content="1.19.4"/>
                    </ComboBox>

                    <ComboBox Grid.Column="3" x:Name="CmbCategory" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbCategory_SelectionChanged">
                        <ComboBoxItem Content="Todas las Categorías"/>
                        <ComboBoxItem Content="Administración"/>
                        <ComboBoxItem Content="Utilidades"/>
                        <ComboBoxItem Content="Rendimiento"/>
                    </ComboBox>

                    <TextBox Grid.Column="4" x:Name="TxtSearch" PlaceholderText="Buscar por nombre o palabra clave..." TextChanged="TxtSearch_TextChanged" CornerRadius="8"/>
                </Grid>
            </StackPanel>

            <GridView Grid.Row="1" x:Name="GrdMarketplaceItems" IsItemClickEnabled="True" ItemClick="GrdMarketplaceItems_ItemClick">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="270" Height="160" Background="#20888888" CornerRadius="12" Padding="14" Margin="6" BorderBrush="#30888888" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Image.Source>
                                            <BitmapImage UriSource="{Binding IconUrl}" />
                                        </Image.Source>
                                    </Image>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#20000000" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SourceName}" FontSize="9"/>
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" MaxLines="2" Margin="0,6,0,0"/>

                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding FormattedDownloads}" FontSize="10" VerticalAlignment="Center"/>
                                    <Button Content="Ver Detalles" Tag="{Binding}" Click="BtnOpenDetails_Click" Background="#22C55E" Foreground="White" CornerRadius="6" HorizontalAlignment="Right" Padding="12,4" FontSize="11"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,12,0,0">
                <Button x:Name="BtnPrevPage" Content="◀ Anterior" Click="BtnPrevPage_Click" CornerRadius="8"/>
                <TextBlock x:Name="TxtPageNumber" Text="Página 1" VerticalAlignment="Center" FontWeight="Bold"/>
                <Button x:Name="BtnNextPage" Content="Siguiente ▶" Click="BtnNextPage_Click" CornerRadius="8"/>
            </StackPanel>
        </Grid>

        <!-- Item Details View with Tabs (Descripción, Imágenes, Versiones, Fuentes) -->
        <Grid x:Name="ViewItemDetails" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">
                <Button Content="← Volver al Catálogo" Click="BtnBackToCatalog_Click" CornerRadius="6" Padding="12,6"/>

                <Border Background="#20888888" CornerRadius="12" Padding="18" BorderBrush="#30888888" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Image x:Name="ImgDetailIcon" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtDetailTitle" Text="Título del Proyecto" FontSize="20" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="TxtDetailAuthor" Text="Autor: -" FontSize="12"/>
                                <TextBlock x:Name="TxtDetailDownloads" Text="Descargas: -" FontSize="12"/>
                                <Border Background="#20000000" CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="TxtDetailSourceTag" Text="Fuente: Modrinth" FontSize="10"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2" x:Name="BtnDetailInstall" Content="🚀 Instalar en Servidor" Click="BtnDetailInstall_Click" Background="#22C55E" Foreground="White" FontWeight="Bold" FontSize="14" CornerRadius="8" Padding="18,8" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <TabView Grid.Row="1" IsAddTabButtonVisible="False">
                <TabViewItem Header="Descripción" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <TextBlock x:Name="TxtDetailDescription" TextWrapping="Wrap" FontSize="13"/>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem Header="Imágenes / Galería" IsClosable="False">
                    <Grid Padding="16">
                        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEB9F;" FontSize="36"/>
                            <TextBlock Text="Vista previa e imágenes del proyecto proporcionadas por la API." FontSize="12" Foreground="#888888"/>
                        </StackPanel>
                    </Grid>
                </TabViewItem>

                <TabViewItem Header="Versiones y Fuentes" IsClosable="False">
                    <Grid Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Orígenes Disponibles para este Proyecto" FontWeight="Bold" FontSize="14"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Modrinth API (Oficial)" Click="BtnSwitchSourceModrinth_Click" CornerRadius="6"/>
                                <Button Content="Spiget API (SpigotMC)" Click="BtnSwitchSourceSpiget_Click" CornerRadius="6"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabViewItem>
            </TabView>
        </Grid>
    </Grid>
</Page>
