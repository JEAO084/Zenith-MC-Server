<Page
    x:Class="Zenith_MC_Server.Views.MarketplacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Catálogo de Descargas de Plugins y Mods" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="CmbSource" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbSource_SelectionChanged">
                    <ComboBoxItem Content="Todas las Fuentes"/>
                    <ComboBoxItem Content="Modrinth"/>
                    <ComboBoxItem Content="Spigot"/>
                    <ComboBoxItem Content="Bukkit"/>
                </ComboBox>

                <ComboBox Grid.Column="1" x:Name="CmbVersion" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbVersion_SelectionChanged">
                    <ComboBoxItem Content="Todas las Versiones"/>
                    <ComboBoxItem Content="1.20.4"/>
                    <ComboBoxItem Content="1.20.2"/>
                    <ComboBoxItem Content="1.19.4"/>
                </ComboBox>

                <ComboBox Grid.Column="2" x:Name="CmbCategory" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbCategory_SelectionChanged">
                    <ComboBoxItem Content="Todas las Categorías"/>
                    <ComboBoxItem Content="Administración"/>
                    <ComboBoxItem Content="Utilidades"/>
                    <ComboBoxItem Content="Rendimiento"/>
                </ComboBox>

                <TextBox Grid.Column="3" x:Name="TxtSearch" PlaceholderText="Buscar plugins o mods por nombre..." TextChanged="TxtSearch_TextChanged" CornerRadius="8"/>

                <ComboBox Grid.Column="4" x:Name="CmbSort" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbSort_SelectionChanged">
                    <ComboBoxItem Content="Más Descargados"/>
                    <ComboBoxItem Content="Nombre (A-Z)"/>
                </ComboBox>
            </Grid>
        </StackPanel>

        <GridView Grid.Row="1" x:Name="GrdMarketplaceItems" IsItemClickEnabled="True">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Border Width="260" Height="150" Background="#401E1428" CornerRadius="12" Padding="14" Margin="6" BorderBrush="#3A2352" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Image.Source>
                                        <BitmapImage UriSource="{Binding IconUrl}" />
                                    </Image.Source>
                                </Image>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="{Binding Summary}" FontSize="11" Foreground="#CCCCCC" TextWrapping="Wrap" MaxLines="2" Margin="0,6,0,0"/>

                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="{Binding FormattedDownloads}" FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                                <Button Content="Instalar" Tag="{Binding}" Click="BtnInstallItem_Click" Background="#22C55E" Foreground="White" CornerRadius="6" HorizontalAlignment="Right" Padding="12,4" FontSize="11"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,12,0,0">
            <Button x:Name="BtnPrevPage" Content="◀ Anterior" Click="BtnPrevPage_Click" CornerRadius="8"/>
            <TextBlock x:Name="TxtPageNumber" Text="Página 1" VerticalAlignment="Center" FontWeight="Bold" Foreground="#38BDF8"/>
            <Button x:Name="BtnNextPage" Content="Siguiente ▶" Click="BtnNextPage_Click" CornerRadius="8"/>
        </StackPanel>
    </Grid>
</Page>
