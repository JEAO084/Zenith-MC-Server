<Page
    x:Class="Zenith_MC_Server.Views.FileManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#401E1428" CornerRadius="12" Padding="14" Margin="0,0,12,0" BorderBrush="#3A2352" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
                    <TextBlock Text="Explorador de Archivos (Árbol)" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                    <Button Content="↻ Actualizar Árbol" Click="BtnRefreshFiles_Click" HorizontalAlignment="Stretch" CornerRadius="8"/>
                </StackPanel>

                <TreeView Grid.Row="1" x:Name="TreeFileExplorer" ItemInvoked="TreeFileExplorer_ItemInvoked">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="{Binding FormattedSize}" FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                    <Button Content="+ Nuevo Archivo" Click="BtnNewFile_Click" HorizontalAlignment="Stretch" CornerRadius="8"/>
                    <Button Content="Eliminar Seleccionado" Click="BtnDeleteFile_Click" Background="#441111" Foreground="#FF8888" HorizontalAlignment="Stretch" CornerRadius="8"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#40140C1D" CornerRadius="12" Padding="18" BorderBrush="#3A2352" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Document"/>
                        <TextBlock x:Name="TxtEditingFileName" Text="Ningún archivo seleccionado" FontWeight="SemiBold" FontSize="14" Foreground="#38BDF8"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Guardar Cambios" Click="BtnSaveFileContent_Click" Background="#7C3AED" Foreground="White" FontWeight="Bold" CornerRadius="8"/>
                </Grid>

                <TextBox Grid.Row="1" x:Name="TxtCodeEditor" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, Courier New" FontSize="13" Background="#401E1428" Foreground="#E2E8F0" BorderThickness="1" BorderBrush="#3A2352"/>

                <TextBlock Grid.Row="2" x:Name="TxtFileEditorStatus" Text="Edita cualquier archivo de configuración directamente desde la interfaz del launcher." FontSize="11" Foreground="#AAAAAA" Margin="0,8,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Page>
