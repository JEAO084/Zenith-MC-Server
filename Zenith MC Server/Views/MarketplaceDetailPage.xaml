<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Zenith_MC_Server.Views.MarketplaceDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Zenith_MC_Server.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="840" HorizontalAlignment="Left" Spacing="20">
            <!-- Back Navigation Bar -->
            <Button x:Name="BackButton" Content="← Volver al Marketplace" Click="BackButton_Click"/>

            <!-- Item Main Header Banner -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="ItemIconImage" Grid.Column="0" Width="80" Height="80" VerticalAlignment="Top" Stretch="UniformToFill"/>

                    <StackPanel Grid.Column="1" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="TitleTextBlock" Text="Nombre del Plugin / Mod" FontSize="22" FontWeight="Bold"/>
                            <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <TextBlock x:Name="CategoryTextBlock" Text="Plugin" Foreground="White" FontSize="12"/>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="SummaryTextBlock" Text="Resumen breve..." TextWrapping="Wrap" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>

                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <TextBlock x:Name="AuthorTextBlock" Text="Autor: -" FontSize="13" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            <TextBlock x:Name="DownloadsTextBlock" Text="Descargas: -" FontSize="13" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            <TextBlock x:Name="VersionTextBlock" Text="Versión: -" FontSize="13" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="InstallButton" Grid.Column="2" Content="Instalar .jar en Servidor Activo" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Click="InstallButton_Click"/>
                </Grid>
            </Border>

            <!-- Metadata Details: Supported Loaders & Game Versions -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Loaders Soportados" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LoadersTextBlock" Text="Paper, Purpur, Spigot" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Versiones de Minecraft Soportadas" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="GameVersionsTextBlock" Text="1.20.4, 1.20.1, 1.19.4" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Screenshot Gallery Images -->
            <Border x:Name="GalleryBorder" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Galería de Capturas de Pantalla" FontSize="16" FontWeight="SemiBold"/>
                    <GridView x:Name="GalleryGridView" MaxHeight="220" SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Width="240" Height="150" Stretch="UniformToFill" Margin="4"/>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Border>

            <!-- Detailed Description & Readme -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Descripción Detallada y Documentación" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="DetailedDescriptionTextBlock" Text="Cargando descripción..." TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
