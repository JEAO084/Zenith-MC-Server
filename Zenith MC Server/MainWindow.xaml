                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Gestión Avanzada de Entornos de Ejecución Java (JDK)" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Descarga e instala versiones de Java 8, 17, 21, 22 o 25 sin afectar la configuración del sistema operativo." FontSize="12" Foreground="#BBBBBB"/>

                            <Border Background="#1E1428" CornerRadius="10" Padding="16" BorderBrush="#50000000" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Versiones Disponibles para Servidores de Minecraft" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>

                                    <ListView x:Name="LstJavaVersions" SelectionChanged="LstJavaVersions_SelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#CCCCCC"/>
                                                        <TextBlock Text="{Binding InstalledPath}" FontSize="10" Foreground="#888888"/>
                                                    </StackPanel>
                                                    <Button Content="Instalar JDK" Tag="{Binding}" Click="BtnInstallJavaItem_Click" VerticalAlignment="Center" CornerRadius="6"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <ProgressBar x:Name="JavaDownloadProgress" Value="0" Maximum="100" Height="8" Visibility="Collapsed"/>
                                    <TextBlock x:Name="TxtJavaProgressStatus" Text="" FontSize="11" Foreground="#38BDF8"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 11. INTERFACE CUSTOMIZATION SECTION (ESTILO MICROSOFT STORE CON TEMAS CLARO/OSCURO/TRANSPARENTE) -->
                <Grid x:Name="ViewCustomization" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Personalización Completa de la Interfaz (Estilo Microsoft Store)" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Configura el modo de tema global (Claro, Oscuro, Transparente), colores de acento, y personaliza de forma independiente la Consola Terminal y el Editor de Código." FontSize="12" Foreground="#BBBBBB"/>

                            <!-- Card 1: Theme Mode & Window Backdrop -->
                            <Border Background="#25000000" CornerRadius="10" Padding="16" BorderBrush="#50000000" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Modo de Tema Principal y Fondo de Ventana" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <TextBlock Text="Tema de Aplicación" FontSize="12"/>
                                            <ComboBox x:Name="CmbAppTheme" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbAppTheme_SelectionChanged">
                                                <ComboBoxItem Content="🌙 Oscuro (Dark Studio)"/>
                                                <ComboBoxItem Content="☀️ Claro (Light Clean)"/>
                                                <ComboBoxItem Content="✨ Transparente (Acrylic Glass)"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Color Principal de Acento" FontSize="12"/>
                                            <ComboBox x:Name="CmbAccentColor" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbAccentColor_SelectionChanged">
                                                <ComboBoxItem Content="💜 Púrpura Zenith (#7C3AED)"/>
                                                <ComboBoxItem Content="💙 Azul Neón (#0284C7)"/>
                                                <ComboBoxItem Content="💚 Verde Esmeralda (#10B981)"/>
                                                <ComboBoxItem Content="❤️ Rojo Carmesí (#E11D48)"/>
                                                <ComboBoxItem Content="🧡 Naranja Ámbar (#F59E0B)"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="6">
                                            <TextBlock Text="Efecto Transparente (Backdrop)" FontSize="12"/>
                                            <ComboBox x:Name="CmbBackdropType" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbBackdropType_SelectionChanged">
                                                <ComboBoxItem Content="DesktopAcrylic (Acrylic Thin)"/>
                                                <ComboBoxItem Content="Mica (Efecto Gradiente W11)"/>
                                                <ComboBoxItem Content="Sólido Oscuro"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Terminal Console Customization -->
                            <Border Background="#25000000" CornerRadius="10" Padding="16" BorderBrush="#50000000" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Personalización Independiente de Consola Terminal" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <TextBlock Text="Fondo de Consola" FontSize="12"/>
                                            <ComboBox x:Name="CmbConsoleBg" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbConsoleBg_SelectionChanged">
                                                <ComboBoxItem Content="🌑 Púrpura Oscuro (#140C1D)"/>
                                                <ComboBoxItem Content="⬛ Negro Puro (#000000)"/>
                                                <ComboBoxItem Content="🌫️ Gris Oscuro (#1A1A1A)"/>
                                                <ComboBoxItem Content="🟦 Azul Noche (#0F172A)"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Texto de Consola" FontSize="12"/>
                                            <ComboBox x:Name="CmbConsoleColor" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbConsoleColor_SelectionChanged">
                                                <ComboBoxItem Content="🩵 Azul Cían (#38BDF8)"/>
                                                <ComboBoxItem Content="💚 Verde Matrix (#22C55E)"/>
                                                <ComboBoxItem Content="💛 Amarillo Neón (#FACC15)"/>
                                                <ComboBoxItem Content="🤍 Blanco Puro (#FFFFFF)"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="6">
                                            <TextBlock Text="Fuente de Consola" FontSize="12"/>
                                            <ComboBox x:Name="CmbConsoleFont" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbConsoleFont_SelectionChanged">
                                                <ComboBoxItem Content="Consolas"/>
                                                <ComboBoxItem Content="Cascadia Code"/>
                                                <ComboBoxItem Content="Segoe UI"/>
                                                <ComboBoxItem Content="Courier New"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Code Editor Customization -->
                            <Border Background="#25000000" CornerRadius="10" Padding="16" BorderBrush="#50000000" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Personalización Independiente del Editor de Código / Archivos" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <TextBlock Text="Fondo del Editor" FontSize="12"/>
                                            <ComboBox x:Name="CmbEditorBg" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbEditorBg_SelectionChanged">
                                                <ComboBoxItem Content="🍆 Púrpura Studio (#1E1428)"/>
                                                <ComboBoxItem Content="⬛ Negro Carbono (#121212)"/>
                                                <ComboBoxItem Content="🟦 Azul VS Code (#1E1E2E)"/>
                                                <ComboBoxItem Content="📄 Blanco Papel (#F8FAFC)"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Texto del Editor" FontSize="12"/>
                                            <ComboBox x:Name="CmbEditorFg" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbEditorFg_SelectionChanged">
                                                <ComboBoxItem Content="🤍 Gris Claro (#E2E8F0)"/>
                                                <ComboBoxItem Content="💚 Verde Código (#4ADE80)"/>
                                                <ComboBoxItem Content="🩵 Azul Cían (#38BDF8)"/>
                                                <ComboBoxItem Content="🖤 Negro Tinta (#0F172A)"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="6">
                                            <TextBlock Text="Fuente del Editor" FontSize="12"/>
                                            <ComboBox x:Name="CmbEditorFont" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CmbEditorFont_SelectionChanged">
                                                <ComboBoxItem Content="Consolas"/>
                                                <ComboBoxItem Content="Cascadia Code"/>
                                                <ComboBoxItem Content="Courier New"/>
                                                <ComboBoxItem Content="Segoe UI"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 12. LAUNCHER GLOBAL SETTINGS VIEW -->
                <Grid x:Name="ViewLauncherSettings" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Ajustes Globales y Personalización del Launcher Zenith" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>

                            <Border Background="#25000000" CornerRadius="10" Padding="16" BorderBrush="#50000000" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Personalización del Editor y Aplicación" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Ruta del Editor de Texto Externo Customizado" FontSize="12"/>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtExternalEditorExecutablePath" PlaceholderText="Ej: C:\Program Files\Notepad++\notepad++.exe"/>
                                            <Button Grid.Column="1" Content="Guardar Editor" Click="BtnSaveExternalEditor_Click" CornerRadius="6"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#25000000" CornerRadius="10" Padding="16" BorderBrush="#50000000" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Rutas del Sistema y Descargas" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Carpeta de Runtimes Java (Aislada de AppX)" FontSize="12"/>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtCustomJavaPath" IsReadOnly="True"/>
                                            <Button Grid.Column="1" Content="Restablecer por Defecto" Click="BtnResetJavaPath_Click" CornerRadius="6"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#25000000" CornerRadius="10" Padding="16" BorderBrush="#50000000" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Comportamiento y Automatización" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>

                                    <ToggleSwitch x:Name="ToggleAutoEulaDefault" Header="Aceptar EULA automáticamente en nuevos servidores" IsOn="True"/>
                                    <ToggleSwitch x:Name="ToggleAutoRestart" Header="Reinicio automático del servidor en caso de caída (Auto-restart)" IsOn="False"/>
                                    <ToggleSwitch x:Name="ToggleAikarsDefault" Header="Usar optimización Aikar JVM por defecto" IsOn="True"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </NavigationView>
    </Grid>
</Window>
