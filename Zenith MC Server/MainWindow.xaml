<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zenith_MC_Server.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Zenith_MC_Server"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Zenith MC Server - Minecraft Server Launcher">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Integrated Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="#150B0B18" Height="48" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Logo & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Background="#7C3AED" CornerRadius="8" Width="32" Height="32">
                    <TextBlock Text="Z" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ZENITH MC SERVER" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                    <TextBlock Text="Launcher &amp; Multi-Server Manager (Acrylic Thin Edition)" FontSize="10" Foreground="#A0A0A0"/>
                </StackPanel>
            </StackPanel>

            <!-- Active Server Selector (Multi-Server Manager) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Servidor Activo:" VerticalAlignment="Center" FontSize="12" Foreground="#CCCCCC"/>
                <ComboBox x:Name="CmbServerSelector" Width="200" SelectionChanged="CmbServerSelector_SelectionChanged" DisplayMemberPath="Name" VerticalAlignment="Center"/>
                <Button Content="+ Crear Servidor (Wizard)" Click="BtnOpenWizard_Click" Background="#22C55E" Foreground="White" FontWeight="Bold" CornerRadius="6" Padding="10,4"/>
            </StackPanel>

            <!-- Server Running Status Indicator -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,120,0">
                <Border Background="#25103020" Padding="8,4" CornerRadius="6" BorderThickness="1" BorderBrush="#4000FF66">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" x:Name="StatusIndicatorDot" Fill="#FF4444"/>
                        <TextBlock x:Name="StatusIndicatorText" Text="Servidor Detenido" FontSize="11" Foreground="#DDDDDD" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Main Navigation View -->
        <NavigationView Grid.Row="1" x:Name="NavView" PaneDisplayMode="Left" IsSettingsVisible="False" SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Consola y Control" Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Crear Servidor (Wizard)" Tag="Wizard">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Add"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Configuración Visual" Tag="Config">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Explorador de Archivos" Tag="FileManager">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Entornos Java (JDK)" Tag="JavaRuntimes">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Ajustes Globales" Tag="LauncherSettings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Admin"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Main Content Area -->
            <Grid Padding="20">

                <!-- 1. DASHBOARD / CONSOLE VIEW -->
                <Grid x:Name="ViewDashboard" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Control Panel Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Start/Stop Controls -->
                        <Border Grid.Column="0" Background="#2212121F" CornerRadius="12" Padding="16" Margin="0,0,8,0" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Control del Servidor" FontWeight="SemiBold" FontSize="14" Foreground="#BBBBBB"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BtnStartServer" Content="Iniciar Servidor" Click="BtnStartServer_Click" Background="#22C55E" Foreground="White" FontWeight="Bold" CornerRadius="6" Padding="12,6"/>
                                    <Button x:Name="BtnStopServer" Content="Detener" Click="BtnStopServer_Click" Background="#EF4444" Foreground="White" FontWeight="Bold" CornerRadius="6" Padding="12,6" IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Server Info -->
                        <Border Grid.Column="1" Background="#2212121F" CornerRadius="12" Padding="16" Margin="4,0,4,0" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Información Activa" FontWeight="SemiBold" FontSize="14" Foreground="#BBBBBB"/>
                                <TextBlock x:Name="TxtActiveServerName" Text="Servidor: Servidor Principal" FontSize="12" Foreground="#38BDF8" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtActiveSoftware" Text="Motor: Paper 1.20.4" FontSize="11" Foreground="#DDDDDD"/>
                                <TextBlock x:Name="TxtActivePort" Text="Puerto: 25565" FontSize="11" Foreground="#DDDDDD"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Memory RAM -->
                        <Border Grid.Column="2" Background="#2212121F" CornerRadius="12" Padding="16" Margin="8,0,0,0" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Asignación de Memoria RAM" FontWeight="SemiBold" FontSize="14" Foreground="#BBBBBB"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="RAM:" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox x:Name="CmbRamAllocation" SelectedIndex="1" Width="100" SelectionChanged="CmbRamAllocation_SelectionChanged">
                                        <ComboBoxItem Content="2 GB"/>
                                        <ComboBoxItem Content="4 GB"/>
                                        <ComboBoxItem Content="8 GB"/>
                                        <ComboBoxItem Content="16 GB"/>
                                        <ComboBoxItem Content="24 GB"/>
                                        <ComboBoxItem Content="32 GB"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Console Terminal Output -->
                    <Border Grid.Row="1" Background="#150A0A12" CornerRadius="12" Padding="12" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <ScrollViewer x:Name="ConsoleScrollViewer" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="TxtConsoleLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas, Courier New" FontSize="13" Background="Transparent" Foreground="#38BDF8" BorderThickness="0"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Command Input -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtConsoleInput" Grid.Column="0" PlaceholderText="Ingresa un comando (ej: op Steve, stop, say Hola)..." KeyDown="TxtConsoleInput_KeyDown" CornerRadius="6" Margin="0,0,8,0"/>
                        <Button x:Name="BtnSendCommand" Grid.Column="1" Content="Enviar" Click="BtnSendCommand_Click" Background="#7C3AED" Foreground="White" CornerRadius="6" Padding="16,6"/>
                    </Grid>
                </Grid>

                <!-- 2. SERVER CREATION WIZARD VIEW -->
                <Grid x:Name="ViewWizard" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="20">
                            <TextBlock Text="Asistente de Creación de Servidor por Partes" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>

                            <!-- Step Navigation Header -->
                            <Grid Background="#1D122A" Padding="16" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Border Background="#7C3AED" Width="28" Height="28" CornerRadius="14">
                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Nombre y Versión" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Border Background="#7C3AED" Width="28" Height="28" CornerRadius="14">
                                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Loader / Motor" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <Border Background="#7C3AED" Width="28" Height="28" CornerRadius="14">
                                        <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Entorno Java" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                    <Border Background="#7C3AED" Width="28" Height="28" CornerRadius="14">
                                        <TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="RAM y Parámetros" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                            <!-- Wizard Form Cards -->
                            <StackPanel Spacing="16">

                                <!-- Part 1: Name, Icon & Version -->
                                <Border Background="#2212121F" CornerRadius="12" Padding="16" BorderBrush="#33FFFFFF" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Parte 1: Nombre, Logo e Identidad del Servidor" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>

                                        <Grid ColumnSpacing="16" RowSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="200"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Nombre del Servidor" FontSize="12"/>
                                                <TextBox x:Name="WzdServerName" Text="Mi Servidor Survival"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Logo / Icono Decorativo" FontSize="12"/>
                                                <ComboBox x:Name="WzdServerIcon" HorizontalAlignment="Stretch" SelectedIndex="0">
                                                    <ComboBoxItem Content="⛏️ Minecraft Clásico"/>
                                                    <ComboBoxItem Content="🗡️ Survival / PvP"/>
                                                    <ComboBoxItem Content="🛡️ Hardcore"/>
                                                    <ComboBoxItem Content="🏰 Ciudades / Construcción"/>
                                                    <ComboBoxItem Content="🌌 Skyblock"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                                                <Grid>
                                                    <TextBlock Text="Seleccionar Versión de Minecraft" FontSize="12" VerticalAlignment="Center"/>
                                                    <CheckBox x:Name="WzdChkSnapshots" Content="Mostrar Snapshots y Previews (ej: 26.x / 24w)" Checked="WzdChkSnapshots_CheckedChanged" Unchecked="WzdChkSnapshots_CheckedChanged" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ComboBox x:Name="WzdCmbVersion" SelectionChanged="WzdCmbVersion_SelectionChanged" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Part 2: Loader Engine Selection -->
                                <Border Background="#2212121F" CornerRadius="12" Padding="16" BorderBrush="#33FFFFFF" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Parte 2: Loader / Motor de Servidor Compatible" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>
                                        <TextBlock Text="Cargadores filtrados según la versión seleccionada:" FontSize="12" Foreground="#BBBBBB"/>

                                        <ComboBox x:Name="WzdCmbLoader" HorizontalAlignment="Stretch" SelectedIndex="0">
                                            <ComboBoxItem Content="Paper MC (Rendimiento y Plugins)"/>
                                            <ComboBoxItem Content="Purpur MC (Fork de Paper altamente personalizable)"/>
                                            <ComboBoxItem Content="Spigot MC (Clásico Bukkit/Spigot)"/>
                                            <ComboBoxItem Content="Vanilla (Servidor Oficial Mojang)"/>
                                            <ComboBoxItem Content="Fabric (Mods livianos)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- Part 3: Strict Java Mapping -->
                                <Border Background="#2212121F" CornerRadius="12" Padding="16" BorderBrush="#33FFFFFF" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Parte 3: Verificación y Requisito Estricto de Java" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>

                                        <Border x:Name="WzdJavaNoticeBorder" Background="#1E2A3A" Padding="12" CornerRadius="8">
                                            <StackPanel Spacing="6">
                                                <TextBlock x:Name="WzdTxtJavaRequirement" Text="Requisito Detectado: Java 21 (Necesario para Minecraft 1.20.5+ y 26.x)" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <TextBlock x:Name="WzdTxtJavaStatus" Text="Estado: Verificando disponibilidad..." FontSize="12" Foreground="#DDDDDD"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Part 4: RAM, Aikar's Flags & Finalize -->
                                <Border Background="#2212121F" CornerRadius="12" Padding="16" BorderBrush="#33FFFFFF" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Parte 4: Asignación de Memoria, Flags Aikar y Puerto" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>

                                        <Grid ColumnSpacing="16" RowSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Memoria RAM Asignada" FontSize="12"/>
                                                <ComboBox x:Name="WzdCmbRam" SelectedIndex="1" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="2 GB"/>
                                                    <ComboBoxItem Content="4 GB"/>
                                                    <ComboBoxItem Content="8 GB"/>
                                                    <ComboBoxItem Content="16 GB"/>
                                                    <ComboBoxItem Content="24 GB"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Puerto TCP del Servidor" FontSize="12"/>
                                                <TextBox x:Name="WzdTxtPort" Text="25565"/>
                                            </StackPanel>
                                        </Grid>

                                        <ToggleSwitch x:Name="WzdToggleAikarsFlags" Header="Optimización Avanzada de JVM (Flags de Aikar)" IsOn="True" OffContent="Desactivado" OnContent="Activado (-XX:+UseG1GC...)"/>
                                        <ToggleSwitch x:Name="WzdToggleEula" Header="Aceptar EULA de Minecraft Automáticamente" IsOn="True" OffContent="No" OnContent="Sí (eula=true)"/>

                                        <StackPanel Spacing="6" HorizontalAlignment="Right" Margin="0,12,0,0">
                                            <ProgressBar x:Name="WzdProgressBar" Value="0" Maximum="100" Height="8" Visibility="Collapsed"/>
                                            <TextBlock x:Name="WzdTxtProgressStatus" Text="" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                            <Button x:Name="BtnFinishWizard" Content="🚀 Finalizar y Crear Servidor" Click="BtnFinishWizard_Click" Background="#22C55E" Foreground="White" FontWeight="Bold" FontSize="15" CornerRadius="8" Padding="20,10" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 3. GUI CONFIGURATOR VIEW -->
                <Grid x:Name="ViewConfig" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                        <TextBlock Text="Configuración Visual Total del Servidor" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Ajusta server.properties, eula.txt, spigot.yml y paper.yml mediante interfaz gráfica." FontSize="12" Foreground="#BBBBBB"/>
                    </StackPanel>

                    <Pivot Grid.Row="1">
                        <PivotItem Header="server.properties">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16" Margin="0,12,0,0">
                                    <Border Background="#2212121F" CornerRadius="12" Padding="16" BorderBrush="#33FFFFFF" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Aceptar EULA de Minecraft (eula.txt)" FontWeight="Bold" FontSize="14" Foreground="#38BDF8"/>
                                                <TextBlock Text="Requerido para que el servidor inicie correctamente." FontSize="12" Foreground="#AAAAAA"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="ToggleEula" Grid.Column="1" OffContent="No Aceptado" OnContent="Aceptado (eula=true)" Toggled="ToggleEula_Toggled"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="#2212121F" CornerRadius="12" Padding="16" BorderBrush="#33FFFFFF" BorderThickness="1">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Ajustes de Juego y Red" FontWeight="SemiBold" FontSize="15" Foreground="#A78BFA"/>
                                            <Grid RowSpacing="12" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="MOTD (Mensaje del Día)" FontSize="12"/>
                                                    <TextBox x:Name="CfgMotd" Text="A Minecraft Server"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="Jugadores Máximos" FontSize="12"/>
                                                    <TextBox x:Name="CfgMaxPlayers" Text="20"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="Modo de Juego" FontSize="12"/>
                                                    <ComboBox x:Name="CfgGamemode" HorizontalAlignment="Stretch" SelectedIndex="0">
                                                        <ComboBoxItem Content="survival"/>
                                                        <ComboBoxItem Content="creative"/>
                                                        <ComboBoxItem Content="adventure"/>
                                                        <ComboBoxItem Content="spectator"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="Dificultad" FontSize="12"/>
                                                    <ComboBox x:Name="CfgDifficulty" HorizontalAlignment="Stretch" SelectedIndex="1">
                                                        <ComboBoxItem Content="peaceful"/>
                                                        <ComboBoxItem Content="easy"/>
                                                        <ComboBoxItem Content="normal"/>
                                                        <ComboBoxItem Content="hard"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="Puerto" FontSize="12"/>
                                                    <TextBox x:Name="CfgServerPort" Text="25565"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                                                    <ToggleSwitch x:Name="CfgOnlineMode" Header="Modo Online (Cuentas Premium)" OffContent="No" OnContent="Sí"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </PivotItem>

                        <PivotItem Header="paper-global.yml">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="TxtPaperConfigEditor" AcceptsReturn="True" FontFamily="Consolas" FontSize="13" Background="#120D18" Foreground="#E2E8F0"/>
                                <Button Grid.Row="1" Content="Guardar paper-global.yml" Click="BtnSavePaperConfig_Click" Background="#7C3AED" Foreground="White" Margin="0,8,0,0" HorizontalAlignment="Right"/>
                            </Grid>
                        </PivotItem>

                        <PivotItem Header="spigot.yml">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="TxtSpigotConfigEditor" AcceptsReturn="True" FontFamily="Consolas" FontSize="13" Background="#120D18" Foreground="#E2E8F0"/>
                                <Button Grid.Row="1" Content="Guardar spigot.yml" Click="BtnSaveSpigotConfig_Click" Background="#7C3AED" Foreground="White" Margin="0,8,0,0" HorizontalAlignment="Right"/>
                            </Grid>
                        </PivotItem>
                    </Pivot>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,12,0,0">
                        <Button Content="Recargar Propiedades" Click="BtnReloadConfig_Click" CornerRadius="6" Padding="16,8"/>
                        <Button Content="Guardar server.properties" Click="BtnSaveConfig_Click" Background="#7C3AED" Foreground="White" FontWeight="Bold" CornerRadius="6" Padding="16,8"/>
                    </StackPanel>
                </Grid>

                <!-- 4. FILE MANAGER & CODE EDITOR VIEW -->
                <Grid x:Name="ViewFileManager" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#1C1422" CornerRadius="12" Padding="12" Margin="0,0,12,0" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
                                <TextBlock Text="Archivos del Servidor" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                <Button Content="↻ Actualizar Lista" Click="BtnRefreshFiles_Click" HorizontalAlignment="Stretch" CornerRadius="6"/>
                            </StackPanel>

                            <ListView Grid.Row="1" x:Name="LstFileItems" SelectionChanged="LstFileItems_SelectionChanged" DisplayMemberPath="Name"/>

                            <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                                <Button Content="+ Nuevo Archivo" Click="BtnNewFile_Click" HorizontalAlignment="Stretch" CornerRadius="6"/>
                                <Button Content="Eliminar Seleccionado" Click="BtnDeleteFile_Click" Background="#441111" Foreground="#FF8888" HorizontalAlignment="Stretch" CornerRadius="6"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="#150A0A12" CornerRadius="12" Padding="16" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <SymbolIcon Symbol="Document"/>
                                    <TextBlock x:Name="TxtEditingFileName" Text="Ningún archivo seleccionado" FontWeight="SemiBold" FontSize="14" Foreground="#38BDF8"/>
                                </StackPanel>

                                <Button Grid.Column="1" x:Name="BtnSaveFileContent" Content="Guardar Cambios en Archivo" Click="BtnSaveFileContent_Click" Background="#7C3AED" Foreground="White" FontWeight="Bold" CornerRadius="6"/>
                            </Grid>

                            <TextBox Grid.Row="1" x:Name="TxtCodeEditor" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, Courier New" FontSize="13" Background="#120D18" Foreground="#E2E8F0" BorderThickness="1" BorderBrush="#33FFFFFF"/>

                            <TextBlock Grid.Row="2" x:Name="TxtFileEditorStatus" Text="Selecciona un archivo para editar su contenido directamente desde el launcher." FontSize="11" Foreground="#AAAAAA" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 5. JAVA RUNTIMES MANAGER VIEW -->
                <Grid x:Name="ViewJavaRuntimes" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Gestión Avanzada de Entornos de Ejecución Java (JDK)" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Descarga e instala versiones de Java 8, 17, 21, 22 o 25 sin afectar la configuración del sistema operativo." FontSize="12" Foreground="#BBBBBB"/>

                            <Border Background="#2212121F" CornerRadius="12" Padding="16" BorderBrush="#33FFFFFF" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Versiones Disponibles para Servidores de Minecraft" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>

                                    <ListView x:Name="LstJavaVersions" SelectionChanged="LstJavaVersions_SelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#CCCCCC"/>
                                                        <TextBlock Text="{Binding InstalledPath}" FontSize="10" Foreground="#888888"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" x:Name="BtnInstallJavaItem" Content="Instalar JDK" Tag="{Binding}" Click="BtnInstallJavaItem_Click" VerticalAlignment="Center" CornerRadius="6"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <ProgressBar x:Name="JavaDownloadProgress" Value="0" Maximum="100" Height="8" Visibility="Collapsed"/>
                                    <TextBlock x:Name="TxtJavaProgressStatus" Text="" FontSize="11" Foreground="#38BDF8"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 6. LAUNCHER GLOBAL SETTINGS VIEW -->
                <Grid x:Name="ViewLauncherSettings" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Ajustes Globales del Launcher Zenith" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>

                            <Border Background="#2212121F" CornerRadius="12" Padding="16" BorderBrush="#33FFFFFF" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Rutas del Sistema y Descargas" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Carpeta de Runtimes Java (Aislada de AppX)" FontSize="12"/>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtCustomJavaPath" IsReadOnly="True"/>
                                            <Button Grid.Column="1" Content="Restablecer por Defecto" Click="BtnResetJavaPath_Click" CornerRadius="6"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#2212121F" CornerRadius="12" Padding="16" BorderBrush="#33FFFFFF" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Comportamiento y Automatización" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>

                                    <ToggleSwitch x:Name="ToggleAutoEulaDefault" Header="Aceptar EULA automáticamente en nuevos servidores" IsOn="True"/>
                                    <ToggleSwitch x:Name="ToggleAutoRestart" Header="Reinicio automático del servidor en caso de caída (Auto-restart)" IsOn="False"/>
                                    <ToggleSwitch x:Name="ToggleAikarsDefault" Header="Usar optimización Aikar JVM por defecto" IsOn="True"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#2212121F" CornerRadius="12" Padding="16" BorderBrush="#33FFFFFF" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Diseño y Efectos Visuales" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>
                                    <TextBlock Text="Fondo de Ventana Activo: DesktopAcrylicBackdrop (Acrylic Thin)" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                    <TextBlock Text="La interfaz utiliza desenfoque acrílico delgado de Windows 11 / 10 para una integración estética moderna." FontSize="11" Foreground="#AAAAAA"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </NavigationView>
    </Grid>
</Window>
