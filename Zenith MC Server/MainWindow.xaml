<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zenith_MC_Server.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Zenith_MC_Server"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ZENITH MC SERVER">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="#20000000" PointerPressed="RootGrid_PointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Acrylic TitleBar Grid for SetTitleBar(AppTitleBar) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="#20000000" Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Controls (Header Left) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="BtnNavigateBack" Click="BtnNavigateBack_Click" VerticalAlignment="Center" Padding="8,6" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Atrás (Botón 4 / Mouse Side)">
                    <SymbolIcon Symbol="Back"/>
                </Button>
                <Button x:Name="BtnTogglePane" Click="BtnTogglePane_Click" VerticalAlignment="Center" Padding="8,6" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Alternar Panel">
                    <SymbolIcon Symbol="AllApps"/>
                </Button>
            </StackPanel>

            <!-- App Title & Subtitle -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                <FontIcon Glyph="&#xE700;" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="ZENITH MC SERVER" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Server Selector & Profile Controls (Center) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock x:Name="TxtActiveServerLabel" Text="Servidor Activo:" VerticalAlignment="Center" FontSize="12" Foreground="#CCCCCC"/>
                <ComboBox x:Name="CmbServerSelector" Width="180" SelectionChanged="CmbServerSelector_SelectionChanged" DisplayMemberPath="Name" VerticalAlignment="Center"/>

                <!-- Minimalist Icon Button for Server Profile Manager -->
                <Button Click="BtnManageServers_Click" Padding="8,6" CornerRadius="6" VerticalAlignment="Center" ToolTipService.ToolTip="Administrar Servidores">
                    <SymbolIcon Symbol="Setting"/>
                </Button>

                <!-- Minimalist Plus Icon Button for Creating Server -->
                <Button Click="BtnOpenWizard_Click" Background="#22C55E" Foreground="White" Padding="8,6" CornerRadius="6" VerticalAlignment="Center" ToolTipService.ToolTip="Crear Servidor">
                    <SymbolIcon Symbol="Add"/>
                </Button>
            </StackPanel>

            <!-- Status Indicator (Right) -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,120,0">
                <Border Background="#20000000" Padding="8,4" CornerRadius="6" BorderThickness="1" BorderBrush="#30FFFFFF">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" x:Name="StatusIndicatorDot" Fill="#FF4444"/>
                        <TextBlock x:Name="StatusIndicatorText" Text="Servidor Detenido" FontSize="11" Foreground="#DDDDDD" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Main Navigation View -->
        <NavigationView Grid.Row="1" x:Name="NavView" PaneDisplayMode="Left" IsSettingsVisible="True" IsBackButtonVisible="Auto" BackRequested="NavView_BackRequested" SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Consola y Control" Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Configuración del Servidor" Tag="Config">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Marketplace Plugins &amp; Mods" Tag="Marketplace">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Explorador de Archivos" Tag="FileManager">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Entornos Java (JDK)" Tag="JavaRuntimes">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Server Profile Manager Flyout Overlay -->
            <Grid>
                <Frame x:Name="ContentFrame" />

                <!-- ContentDialog for Server Profile Manager / 1-Click Profile Selection / Delete -->
                <ContentDialog x:Name="ServerManagerDialog" Title="Administración de Servidores" PrimaryButtonText="Cerrar" IsPrimaryButtonEnabled="True" CloseButtonText="">
                    <StackPanel Spacing="12" Width="420">
                        <TextBlock Text="Haz clic en un servidor para seleccionarlo como activo:" FontSize="12" Foreground="#AAAAAA"/>
                        <ListView x:Name="LstServerProfilesDialog" Height="200" IsItemClickEnabled="True" ItemClick="LstServerProfilesDialog_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="{Binding Version}" FontSize="11" Foreground="#888888"/>
                                        </StackPanel>
                                        <Button Content="Eliminar" Tag="{Binding}" Click="BtnDeleteServerProfile_Click" Background="#EF4444" Foreground="White" CornerRadius="6" Grid.Column="1" VerticalAlignment="Center" Padding="8,4" FontSize="11"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Inline Delete Confirmation Banner (Prevents COMException 0x80000019) -->
                        <Border x:Name="InlineDeleteConfirmBorder" Background="#20EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="12" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="TxtInlineDeleteConfirmText" Text="¿Estás seguro de eliminar este servidor?" FontWeight="Bold" FontSize="12" Foreground="#EF4444" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button Content="Cancelar" Click="BtnCancelInlineDelete_Click" CornerRadius="6" Padding="10,4" FontSize="11"/>
                                    <Button Content="Confirmar Eliminación" Click="BtnConfirmInlineDelete_Click" Background="#EF4444" Foreground="White" FontWeight="Bold" CornerRadius="6" Padding="10,4" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ContentDialog>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
