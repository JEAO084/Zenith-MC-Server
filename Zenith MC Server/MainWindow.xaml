<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zenith_MC_Server.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Zenith_MC_Server"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Zenith MC Server - Minecraft Server Launcher">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="#110B18" PointerPressed="RootGrid_PointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Integrated Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="#1A1024" Height="48" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Logo & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border x:Name="BrandLogoBorder" Background="#7C3AED" CornerRadius="8" Width="32" Height="32">
                    <TextBlock Text="Z" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAppTitle" Text="ZENITH MC SERVER" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                    <TextBlock Text="Launcher &amp; Multi-Server Manager (Acrylic Thin Edition)" FontSize="10" Foreground="#A0A0A0"/>
                </StackPanel>
            </StackPanel>

            <!-- Active Server Selector & Navigation Back -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <Button Content="← Atrás (Botón 4)" Click="BtnNavigateBack_Click" Background="#2C1D3B" Foreground="White" CornerRadius="6" Padding="8,4" FontSize="11" BorderBrush="#3A2352" BorderThickness="1"/>
                <TextBlock x:Name="TxtActiveServerLabel" Text="Servidor Activo:" VerticalAlignment="Center" FontSize="12" Foreground="#CCCCCC"/>
                
                <Button Content="+" Click="BtnOpenWizard_Click" Background="Transparent" Foreground="Gray" FontWeight="Bold" CornerRadius="6" Padding="10,4"/>
            </StackPanel>

            <!-- Server Running Status Indicator -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,120,0">
                <Border Background="#1C2B20" Padding="8,4" CornerRadius="6" BorderThickness="1" BorderBrush="#4000FF66">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" x:Name="StatusIndicatorDot" Fill="#FF4444"/>
                        <TextBlock x:Name="StatusIndicatorText" Text="Servidor Detenido" FontSize="11" Foreground="#DDDDDD" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Main Navigation View <ComboBox x:Name="CmbServerSelector" Width="200" SelectionChanged="CmbServerSelector_SelectionChanged" DisplayMemberPath="Name" VerticalAlignment="Center"/> -->
        <NavigationView Grid.Row="1" x:Name="NavView" PaneDisplayMode="Left" IsSettingsVisible="False" SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play"/>
                    </NavigationViewItem.Icon>
                    <ComboBox x:Name="CmbServerSelector" 
                              Margin="5,10,5,5" 
                              Header="Consola y Control" 
                              SelectionChanged="CmbServerSelector_SelectionChanged" 
                              DisplayMemberPath="Name" 
                              VerticalAlignment="Center" 
                              HorizontalAlignment="Stretch"/>
                </NavigationViewItem>

                <NavigationViewItem Content="Configuración del Servidor" Tag="Config">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavItemDownloadPlugins" Content="Descargar Plugins" Tag="DownloadPlugins">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavItemDownloadMods" Content="Descargar Mods" Tag="DownloadMods">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavItemInstalledPlugins" Content="Plugins Instalados" Tag="InstalledPlugins">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="AllApps"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavItemInstalledMods" Content="Mods Instalados" Tag="InstalledMods">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="AllApps"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Explorador de Archivos" Tag="FileManager">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Entornos Java (JDK)" Tag="JavaRuntimes">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Personalización de Interfaz" Tag="Customization">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Edit"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Ajustes Globales" Tag="LauncherSettings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Admin"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Main Content Area -->
            <Grid Padding="20">

                <!-- 1. DASHBOARD / CONSOLE VIEW -->
                <Grid x:Name="ViewDashboard" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1E1428" CornerRadius="10" Padding="16" Margin="0,0,8,0" BorderBrush="#3A2352" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Control de Ejecución" FontWeight="SemiBold" FontSize="14" Foreground="#BBBBBB"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BtnStartServer" Content="Iniciar Servidor" Click="BtnStartServer_Click" Background="#22C55E" Foreground="White" FontWeight="Bold" CornerRadius="6" Padding="12,6"/>
                                    <Button x:Name="BtnStopServer" Content="Detener" Click="BtnStopServer_Click" Background="#EF4444" Foreground="White" FontWeight="Bold" CornerRadius="6" Padding="12,6" IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#1E1428" CornerRadius="10" Padding="16" Margin="8,0,0,0" BorderBrush="#3A2352" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Información Activa del Servidor" FontWeight="SemiBold" FontSize="14" Foreground="#BBBBBB"/>
                                <TextBlock x:Name="TxtActiveServerName" Text="Servidor: Servidor Principal" FontSize="12" Foreground="#38BDF8" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtActiveSoftware" Text="Motor: Paper 1.20.4" FontSize="11" Foreground="#DDDDDD"/>
                                <TextBlock x:Name="TxtActivePort" Text="Puerto: 25565" FontSize="11" Foreground="#DDDDDD"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="ConsoleContainerBorder" Grid.Row="1" Background="#140C1D" CornerRadius="10" Padding="12" BorderBrush="#3A2352" BorderThickness="1">
                        <ScrollViewer x:Name="ConsoleScrollViewer" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="TxtConsoleLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas, Courier New" FontSize="13" Background="Transparent" Foreground="#38BDF8" BorderThickness="0"/>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="CmdSuggestionContainer" Grid.Row="0" Grid.Column="0" Background="#1E1428" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="6" Margin="0,0,8,4" Visibility="Collapsed" Canvas.ZIndex="100">
                            <ListView x:Name="LstCmdSuggestions" MaxHeight="120" SelectionChanged="LstCmdSuggestions_SelectionChanged"/>
                        </Border>

                        <TextBox x:Name="TxtConsoleInput" Grid.Row="1" Grid.Column="0" PlaceholderText="Ingresa un comando (ej: gamemode creative, op, teleport)..." TextChanged="TxtConsoleInput_TextChanged" KeyDown="TxtConsoleInput_KeyDown" CornerRadius="6" Margin="0,0,8,0"/>
                        <Button x:Name="BtnSendCommand" Grid.Row="1" Grid.Column="1" Content="Enviar" Click="BtnSendCommand_Click" Background="#7C3AED" Foreground="White" CornerRadius="6" Padding="16,6"/>
                    </Grid>
                </Grid>

                <!-- 2. SERVER CREATION WIZARD VIEW -->
                <Grid x:Name="ViewWizard" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="20">
                            <TextBlock Text="Asistente de Creación de Servidor por Partes" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>

                            <Grid Background="#1E1428" Padding="16" CornerRadius="10" BorderBrush="#3A2352" BorderThickness="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Border Background="#7C3AED" Width="28" Height="28" CornerRadius="14">
                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Nombre y Versión" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Border Background="#7C3AED" Width="28" Height="28" CornerRadius="14">
                                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Loader / Motor" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <Border Background="#7C3AED" Width="28" Height="28" CornerRadius="14">
                                        <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Entorno Java" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                    <Border Background="#7C3AED" Width="28" Height="28" CornerRadius="14">
                                        <TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="RAM y Parámetros" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="16">
                                <Border Background="#1E1428" CornerRadius="10" Padding="16" BorderBrush="#3A2352" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Parte 1: Nombre, Logo e Identidad del Servidor" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>

                                        <Grid ColumnSpacing="16" RowSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="200"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Nombre del Servidor" FontSize="12"/>
                                                <TextBox x:Name="WzdServerName" Text="Mi Servidor Survival"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Logo / Icono Decorativo" FontSize="12"/>
                                                <ComboBox x:Name="WzdServerIcon" HorizontalAlignment="Stretch" SelectedIndex="0">
                                                    <ComboBoxItem Content="⛏️ Minecraft Clásico"/>
                                                    <ComboBoxItem Content="🗡️ Survival / PvP"/>
                                                    <ComboBoxItem Content="🛡️ Hardcore"/>
                                                    <ComboBoxItem Content="🏰 Ciudades / Construcción"/>
                                                    <ComboBoxItem Content="🌌 Skyblock"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                                                <Grid>
                                                    <TextBlock Text="Seleccionar Versión de Minecraft" FontSize="12" VerticalAlignment="Center"/>
                                                    <CheckBox x:Name="WzdChkSnapshots" Content="Mostrar Snapshots y Previews (ej: 26.x / 24w)" Checked="WzdChkSnapshots_CheckedChanged" Unchecked="WzdChkSnapshots_CheckedChanged" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ComboBox x:Name="WzdCmbVersion" SelectionChanged="WzdCmbVersion_SelectionChanged" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#1E1428" CornerRadius="10" Padding="16" BorderBrush="#3A2352" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Parte 2: Loader / Motor de Servidor Compatible" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>
                                        <TextBlock Text="Cargadores filtrados según la versión seleccionada:" FontSize="12" Foreground="#BBBBBB"/>

                                        <ComboBox x:Name="WzdCmbLoader" HorizontalAlignment="Stretch" SelectedIndex="0">
                                            <ComboBoxItem Content="Paper MC (Rendimiento y Plugins)"/>
                                            <ComboBoxItem Content="Purpur MC (Fork de Paper highly customizable)"/>
                                            <ComboBoxItem Content="Spigot MC (Clásico Bukkit/Spigot)"/>
                                            <ComboBoxItem Content="Vanilla (Servidor Oficial Mojang)"/>
                                            <ComboBoxItem Content="Fabric (Mods livianos)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <Border Background="#1E1428" CornerRadius="10" Padding="16" BorderBrush="#3A2352" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Parte 3: Verificación y Requisito Estricto de Java" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>

                                        <Border x:Name="WzdJavaNoticeBorder" Background="#2C1D3B" Padding="12" CornerRadius="8">
                                            <StackPanel Spacing="6">
                                                <TextBlock x:Name="WzdTxtJavaRequirement" Text="Requisito Detectado: Java 21 (Necesario para Minecraft 1.20.5+ y 26.x)" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <TextBlock x:Name="WzdTxtJavaStatus" Text="Estado: Verificando disponibilidad..." FontSize="12" Foreground="#DDDDDD"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Background="#1E1428" CornerRadius="10" Padding="16" BorderBrush="#3A2352" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Parte 4: Asignación de Memoria, Flags Aikar y Puerto" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>

                                        <Grid ColumnSpacing="16" RowSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Memoria RAM Asignada" FontSize="12"/>
                                                <ComboBox x:Name="WzdCmbRam" SelectedIndex="1" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="2 GB"/>
                                                    <ComboBoxItem Content="4 GB"/>
                                                    <ComboBoxItem Content="8 GB"/>
                                                    <ComboBoxItem Content="16 GB"/>
                                                    <ComboBoxItem Content="24 GB"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Puerto TCP del Servidor" FontSize="12"/>
                                                <TextBox x:Name="WzdTxtPort" Text="25565"/>
                                            </StackPanel>
                                        </Grid>

                                        <ToggleSwitch x:Name="WzdToggleAikarsFlags" Header="Optimización Avanzada de JVM (Flags de Aikar)" IsOn="True" OffContent="Desactivado" OnContent="Activado (-XX:+UseG1GC...)"/>
                                        <ToggleSwitch x:Name="WzdToggleEula" Header="Aceptar EULA de Minecraft Automáticamente" IsOn="True" OffContent="No" OnContent="Sí (eula=true)"/>

                                        <StackPanel Spacing="6" HorizontalAlignment="Right" Margin="0,12,0,0">
                                            <ProgressBar x:Name="WzdProgressBar" Value="0" Maximum="100" Height="8" Visibility="Collapsed"/>
                                            <TextBlock x:Name="WzdTxtProgressStatus" Text="" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                            <Button x:Name="BtnFinishWizard" Content="🚀 Finalizar y Crear Servidor" Click="BtnFinishWizard_Click" Background="#22C55E" Foreground="White" FontWeight="Bold" FontSize="15" CornerRadius="8" Padding="20,10" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 3. SERVER SETTINGS VIEW (CONFIGURACIÓN DEL SERVIDOR) -->
                <Grid x:Name="ViewConfig" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                        <TextBlock Text="Configuración Total del Servidor Activo" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Ajustes de Hardware, RAM, Parámetros JVM, server.properties completo, eula.txt, spigot.yml y paper.yml." FontSize="12" Foreground="#BBBBBB"/>
                    </StackPanel>

                    <TabView Grid.Row="1" IsAddTabButtonVisible="False">
                        <!-- Tab 1: Hardware & Execution Settings -->
                        <TabViewItem Header="Hardware y Ejecución" IsClosable="False">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16" Margin="0,12,0,0">
                                    <Border Background="#1E1428" CornerRadius="10" Padding="16" BorderBrush="#3A2352" BorderThickness="1">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Ajustes de Rendimiento y Memoria RAM" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="Asignación de Memoria RAM" FontSize="12"/>
                                                    <ComboBox x:Name="CmbRamAllocation" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="CmbRamAllocation_SelectionChanged">
                                                        <ComboBoxItem Content="2 GB"/>
                                                        <ComboBoxItem Content="4 GB"/>
                                                        <ComboBoxItem Content="8 GB"/>
                                                        <ComboBoxItem Content="16 GB"/>
                                                        <ComboBoxItem Content="24 GB"/>
                                                        <ComboBoxItem Content="32 GB"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="Ruta Ejecutable de Java Customizada" FontSize="12"/>
                                                    <TextBox x:Name="TxtServerCustomJavaExe" PlaceholderText="Ej: C:\Program Files\Java\jdk-21\bin\java.exe"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#1E1428" CornerRadius="10" Padding="16" BorderBrush="#50000000" BorderThickness="1">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Argumentos Personalizados de la Máquina Virtual (JVM)" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA"/>
                                            <TextBox x:Name="TxtCustomJvmArgs" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="80"/>
                                            <Button Content="Cargar Banderas de Optimización de Aikar" Click="BtnApplyAikarsFlags_Click" CornerRadius="6" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>

                        <!-- Tab 2: Extended server.properties -->
                        <TabViewItem Header="server.properties Completo" IsClosable="False">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16" Margin="0,12,0,0">
                                    <Border Background="#1E1428" CornerRadius="10" Padding="16" BorderBrush="#50000000" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Aceptar EULA de Minecraft (eula.txt)" FontWeight="Bold" FontSize="14" Foreground="#38BDF8"/>
                                                <TextBlock Text="Requerido para que el servidor inicie correctamente." FontSize="12" Foreground="#AAAAAA"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="ToggleEula" Grid.Column="1" OffContent="No Aceptado" OnContent="Aceptado (eula=true)" Toggled="ToggleEula_Toggled"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="#1E1428" CornerRadius="10" Padding="16" BorderBrush="#50000000" BorderThickness="1">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Propiedades Básicas y Red" FontSize="15" FontWeight="SemiBold" Foreground="#A78BFA"/>
                                            <Grid RowSpacing="12" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="MOTD (Mensaje del Día)" FontSize="12"/>
                                                    <TextBox x:Name="CfgMotd" Text="A Minecraft Server"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="Jugadores Máximos" FontSize="12"/>
                                                    <TextBox x:Name="CfgMaxPlayers" Text="20"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="Modo de Juego" FontSize="12"/>
                                                    <ComboBox x:Name="CfgGamemode" HorizontalAlignment="Stretch" SelectedIndex="0">
                                                        <ComboBoxItem Content="survival"/>
                                                        <ComboBoxItem Content="creative"/>
                                                        <ComboBoxItem Content="adventure"/>
                                                        <ComboBoxItem Content="spectator"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="Dificultad" FontSize="12"/>
                                                    <ComboBox x:Name="CfgDifficulty" HorizontalAlignment="Stretch" SelectedIndex="1">
                                                        <ComboBoxItem Content="peaceful"/>
                                                        <ComboBoxItem Content="easy"/>
                                                        <ComboBoxItem Content="normal"/>
                                                        <ComboBoxItem Content="hard"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="Puerto" FontSize="12"/>
                                                    <TextBox x:Name="CfgServerPort" Text="25565"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                                                    <ToggleSwitch x:Name="CfgOnlineMode" Header="Modo Online (Cuentas Premium)" OffContent="No" OnContent="Sí"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Extended Advanced Server Properties Section -->
                                    <Border Background="#1E1428" CornerRadius="10" Padding="16" BorderBrush="#50000000" BorderThickness="1">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Propiedades Avanzadas y de Rendimiento" FontSize="15" FontWeight="SemiBold" Foreground="#A78BFA"/>
                                            <Grid RowSpacing="12" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="Distancia de Visión (View Distance)" FontSize="12"/>
                                                    <TextBox x:Name="CfgViewDistance" Text="10"/>
                                                </StackPanel>

